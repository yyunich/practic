<Window x:Class="Module_6_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт задач" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <DockPanel Margin="10">

        <!-- Панель ввода -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="Новая задача"/>
                <TextBox x:Name="txtTask" Height="28" FontSize="14"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtTask_KeyDown"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                        VerticalAlignment="Bottom" Margin="5">
                <Button Content="Добавить" Width="120" Height="28" 
                        Margin="0,0,5,0" Click="BtnAdd_Click"/>
                <Button Content="Отметить выполненной" Width="180" Height="28"
                        Margin="0,0,5,0" Click="BtnToggle_Click"/>
                <Button Content="Удалить" Width="100" Height="28" 
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>

        <!-- Статус внизу -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" 
                Padding="10" Margin="0,10,0,0">
            <TextBlock x:Name="lblStatus" FontSize="14" FontWeight="Bold"/>
        </Border>

        <!-- Таблица задач -->
        <DataGrid x:Name="grid" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  FontSize="14"
                  RowHeight="28">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" 
                                    Binding="{Binding Id}" 
                                    Width="50"/>

                <DataGridTextColumn Header="Задача" 
                                    Binding="{Binding Title}" 
                                    Width="*"/>

                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding Status}" 
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>