<Window x:Class="Module_5_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="500" Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" 
                Background="#F5F5F5" Margin="0,0,0,10">
            <TextBox x:Name="txtDisplay"
                     Text="0" FontSize="32"
                     HorizontalContentAlignment="Right"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="10,0"/>
        </Border>

        <!-- Кнопки -->
        <UniformGrid Grid.Row="1" Rows="5" Columns="4">

            <!-- Строка 1: C, ±, %, ÷ -->
            <Button Content="C"  Click="BtnClear_Click"    Tag="clear"   FontSize="20"/>
            <Button Content="±"  Click="BtnSign_Click"     Tag="sign"    FontSize="20"/>
            <Button Content="%"  Click="BtnPercent_Click"  Tag="percent" FontSize="20"/>
            <Button Content="÷"  Click="BtnOp_Click"       Tag="/"       FontSize="20"/>

            <!-- Строка 2: 7, 8, 9, × -->
            <Button Content="7" Click="BtnDigit_Click" Tag="7" FontSize="20"/>
            <Button Content="8" Click="BtnDigit_Click" Tag="8" FontSize="20"/>
            <Button Content="9" Click="BtnDigit_Click" Tag="9" FontSize="20"/>
            <Button Content="×" Click="BtnOp_Click"    Tag="*" FontSize="20"/>

            <!-- Строка 3: 4, 5, 6, − -->
            <Button Content="4" Click="BtnDigit_Click" Tag="4" FontSize="20"/>
            <Button Content="5" Click="BtnDigit_Click" Tag="5" FontSize="20"/>
            <Button Content="6" Click="BtnDigit_Click" Tag="6" FontSize="20"/>
            <Button Content="−" Click="BtnOp_Click"    Tag="-" FontSize="20"/>

            <!-- Строка 4: 1, 2, 3, + -->
            <Button Content="1" Click="BtnDigit_Click" Tag="1" FontSize="20"/>
            <Button Content="2" Click="BtnDigit_Click" Tag="2" FontSize="20"/>
            <Button Content="3" Click="BtnDigit_Click" Tag="3" FontSize="20"/>
            <Button Content="+" Click="BtnOp_Click"    Tag="+" FontSize="20"/>

            <!-- Строка 5: 0, ., = (= занимает 2 ячейки) -->
            <Button Content="0" Click="BtnDigit_Click" Tag="0" FontSize="20"/>
            <Button Content="," Click="BtnDot_Click"           FontSize="20"/>
            <Button Content="=" Click="BtnEquals_Click" 
                    Grid.ColumnSpan="2" FontSize="20"
                    Background="#FFB74D"/>
        </UniformGrid>
    </Grid>
</Window>