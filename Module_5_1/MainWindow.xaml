<Window x:Class="Module_5_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рисование на холсте" Height="700" Width="900"
        Background="White">

    <DockPanel>
        <!-- Верхняя панель с кнопками -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" 
                    Background="LightGray" Height="50">
            <Button x:Name="btnLine" Content="Линия" Width="100" Height="35" 
                    Margin="5" Click="BtnLine_Click"/>
            <Button x:Name="btnCircle" Content="Круг" Width="100" Height="35" 
                    Margin="5" Click="BtnCircle_Click"/>
            <Button x:Name="btnSquare" Content="Квадрат" Width="100" Height="35" 
                    Margin="5" Click="BtnSquare_Click"/>
            <Button x:Name="btnClear" Content="Очистить" Width="100" Height="35" 
                    Margin="5" Click="BtnClear_Click"/>

            <TextBlock x:Name="lblMode" Text="Режим: линия" 
                       VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
        </StackPanel>

        <!-- Холст для рисования -->
        <Canvas x:Name="canvas" Background="White" ClipToBounds="True"
                MouseDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"
                MouseUp="Canvas_MouseUp"/>
    </DockPanel>
</Window>