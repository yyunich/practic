<Window x:Class="Module_6_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт сотрудников" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <DockPanel Margin="10">
        <!-- Панель ввода -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="ФИО"/>
                <TextBox x:Name="txtName" Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Должность"/>
                <TextBox x:Name="txtPosition" Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5">
                <TextBlock Text="Отдел"/>
                <TextBox x:Name="txtDepartment" Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="5">
                <TextBlock Text="Зарплата"/>
                <TextBox x:Name="txtSalary" Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" 
                        VerticalAlignment="Bottom" Margin="5">
                <Button Content="Добавить" Width="100" Height="28" 
                        Margin="0,0,5,0" Click="BtnAdd_Click"/>
                <Button Content="Изменить" Width="100" Height="28" 
                        Margin="0,0,5,0" Click="BtnEdit_Click"/>
                <Button Content="Удалить" Width="100" Height="28" 
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>

        <!-- Таблица -->
        <DataGrid x:Name="grid" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          SelectionChanged="Grid_SelectionChanged"
          FontSize="14"
          CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№"           
                            Binding="{Binding Id}"          
                            Width="50"/>

                <DataGridTextColumn Header="ФИО"         
                            Binding="{Binding Name}"        
                            Width="200"/>

                <DataGridTextColumn Header="Должность"   
                            Binding="{Binding Position}"    
                            Width="150"/>

                <DataGridTextColumn Header="Отдел"       
                            Binding="{Binding Department}"  
                            Width="150"/>

                <DataGridTextColumn Header="Зарплата"    
                            Binding="{Binding Salary}"      
                            Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>