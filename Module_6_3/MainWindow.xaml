<Window x:Class="Module_6_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <DockPanel Margin="10">

        <!-- Панель поиска -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Поиск:" 
                       VerticalAlignment="Center" FontSize="14" Margin="5"/>

            <TextBox Grid.Column="1" x:Name="txtSearch" Height="28" 
                     FontSize="14" Margin="5"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtSearch_KeyDown"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5">
                <Button Content="🔍 Найти" Width="100" Height="28" 
                        Margin="0,0,5,0" Click="BtnSearch_Click"/>
                <Button Content="Показать все" Width="130" Height="28" 
                        Click="BtnShowAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Кнопки управления -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    Margin="0,10,0,0">
            <Button Content="📖 Арендовать" Width="150" Height="32" 
                    FontSize="14" Click="BtnBorrow_Click" Background="#C8E6C9"/>
            <Button Content="↩ Вернуть" Width="150" Height="32" 
                    FontSize="14" Margin="10,0,0,0" Click="BtnReturn_Click" Background="#BBDEFB"/>
            <Button Content="➕ Добавить книгу" Width="170" Height="32" 
                    FontSize="14" Margin="10,0,0,0" Click="BtnAdd_Click"/>

            <TextBlock x:Name="lblStatus" VerticalAlignment="Center" 
                       Margin="20,0,0,0" FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Таблица книг -->
        <DataGrid x:Name="grid" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  FontSize="14"
                  RowHeight="28">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" 
                                    Binding="{Binding Id}" 
                                    Width="50"/>

                <DataGridTextColumn Header="Название" 
                                    Binding="{Binding Title}" 
                                    Width="*"/>

                <DataGridTextColumn Header="Автор" 
                                    Binding="{Binding Author}" 
                                    Width="200"/>

                <DataGridTextColumn Header="Год" 
                                    Binding="{Binding Year}" 
                                    Width="80"/>

                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding Status}" 
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>