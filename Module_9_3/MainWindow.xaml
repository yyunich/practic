<Window x:Class="Module_9_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер задач" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления/редактирования задачи -->
        <GroupBox Grid.Row="0" Header="Добавление / Редактирование задачи" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Название задачи:"/>
                    <TextBox x:Name="txtTitle" Height="25"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Приоритет:"/>
                    <ComboBox x:Name="cmbPriority" Height="25" SelectedIndex="0">
                        <ComboBoxItem Content="Низкий"/>
                        <ComboBoxItem Content="Средний"/>
                        <ComboBoxItem Content="Высокий"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Дедлайн (срок):"/>
                    <DatePicker x:Name="dpDeadline" Height="25"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="Прогресс (0-100):"/>
                    <TextBox x:Name="txtProgress" Height="25" Text="0"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                    <Button Content="Создать" Width="90" Height="25" Margin="0,0,5,0" Click="BtnAdd_Click" Background="#C8E6C9"/>
                    <Button Content="Обновить" Width="90" Height="25" Margin="0,0,5,0" Click="BtnEdit_Click" Background="#BBDEFB"/>
                    <Button Content="Удалить" Width="90" Height="25" Click="BtnDelete_Click" Background="#FFCDD2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Таблица задач -->
        <DataGrid x:Name="gridTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionChanged="GridTasks_SelectionChanged" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                <DataGridTextColumn Header="Дедлайн" Binding="{Binding Deadline, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>

                <!-- Столбец с визуальным прогресс-баром -->
                <DataGridTemplateColumn Header="Прогресс" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="15"/>
                                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Выполнена">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Просрочена">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <TextBlock x:Name="lblStatus" Grid.Row="2" Margin="0,10,0,0" FontWeight="Bold" FontSize="14"/>
    </Grid>
</Window>