<Window x:Class="Module_8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Total Manager" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Панели -->
            <RowDefinition Height="30"/>
            <!-- Статус бар -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Левая панель -->
            <ColumnDefinition Width="130"/>
            <!-- Центр с кнопками -->
            <ColumnDefinition Width="*"/>
            <!-- Правая панель -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <DockPanel Grid.Column="0" Margin="5">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="⬆ Вверх" Width="70" Margin="0,0,5,0" Click="BtnUpLeft_Click" FontWeight="Bold"/>
                <ComboBox x:Name="cmbLeftDrives" Width="150" SelectionChanged="CmbLeftDrives_SelectionChanged"/>
            </StackPanel>

            <ListView x:Name="listLeft" MouseDoubleClick="ListLeft_MouseDoubleClick" SelectionMode="Extended" KeyDown="List_KeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>

                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 KeyDown="TextBox_KeyDown" 
                                                 LostFocus="TextBox_LostFocus"
                                                 Loaded="TextBox_Loaded">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Размер" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- ЦЕНТРАЛЬНЫЕ КНОПКИ -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Копировать ⭢" Height="35" Margin="0,3" Click="BtnCopyRight_Click"/>
            <Button Content="Переместить ⭢" Height="35" Margin="0,3" Click="BtnMoveRight_Click"/>
            <Button Content="⬅ Копировать" Height="35" Margin="0,3" Click="BtnCopyLeft_Click"/>
            <Button Content="⬅ Переместить" Height="35" Margin="0,3" Click="BtnMoveLeft_Click"/>

            <Separator Margin="0,8"/>
            <Button Content="✏️ Переименовать" Height="35" Margin="0,3" Click="BtnRename_Click" ToolTip="F2"/>
            <Button Content="📂 Новая папка" Height="35" Margin="0,3" Click="BtnCreateFolder_Click"/>
            <Button Content="❌ Удалить" Height="35" Margin="0,3" Click="BtnDelete_Click"/>
            <Button Content="🔄 Обновить" Height="35" Margin="0,3" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <DockPanel Grid.Column="2" Margin="5">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="⬆ Вверх" Width="70" Margin="0,0,5,0" Click="BtnUpRight_Click" FontWeight="Bold"/>
                <ComboBox x:Name="cmbRightDrives" Width="150" SelectionChanged="CmbRightDrives_SelectionChanged"/>
            </StackPanel>

            <ListView x:Name="listRight" MouseDoubleClick="ListRight_MouseDoubleClick" SelectionMode="Extended" KeyDown="List_KeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>

                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 KeyDown="TextBox_KeyDown" 
                                                 LostFocus="TextBox_LostFocus"
                                                 Loaded="TextBox_Loaded">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Размер" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- СТАТУС БАР -->
        <TextBlock x:Name="lblStatus" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
    </Grid>
</Window>