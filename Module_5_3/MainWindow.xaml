<Window x:Class="Module_5_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер задач" Height="550" Width="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">
        <!-- Панель ввода новой задачи -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox x:Name="txtTask" Width="450" Height="30" 
                     FontSize="14" VerticalContentAlignment="Center"
                     KeyDown="TxtTask_KeyDown"/>
            <Button Content="Добавить" Width="100" Height="30" 
                    Margin="10,0,0,0" FontSize="14"
                    Click="BtnAdd_Click"/>
        </StackPanel>

        <!-- Статус -->
        <TextBlock x:Name="lblStatus" DockPanel.Dock="Bottom" 
                   Margin="0,10,0,0" FontSize="13" Foreground="DarkSlateGray"/>

        <!-- Кнопки управления -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    Margin="0,10,0,0">
            <Button Content="Отметить выполненной" Width="200" Height="35"
                    FontSize="13" Click="BtnToggle_Click"/>
            <Button Content="Удалить" Width="100" Height="35" 
                    Margin="10,0,0,0" FontSize="13" Click="BtnDelete_Click"/>
            <Button Content="Очистить всё" Width="120" Height="35" 
                    Margin="10,0,0,0" FontSize="13" Click="BtnClear_Click"/>
        </StackPanel>

        <!-- Список задач -->
        <ListBox x:Name="lstTasks" FontSize="14" Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" Padding="5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- Выполненные задачи — серые и зачёркнутые -->
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>