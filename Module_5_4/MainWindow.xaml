<Window x:Class="Module_5_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображений" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Панель инструментов -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" 
                    Background="LightGray" Height="50">

            <Button Content="Открыть..." Width="120" Height="35" 
                    Margin="5" Click="BtnOpen_Click"/>

            <Button Content="－ Уменьшить" Width="120" Height="35" 
                    Margin="5" Click="BtnZoomOut_Click"/>

            <Button Content="＋ Увеличить" Width="120" Height="35" 
                    Margin="5" Click="BtnZoomIn_Click"/>

            <Button Content="Сброс" Width="100" Height="35" 
                    Margin="5" Click="BtnReset_Click"/>

            <Button Content="По размеру окна" Width="150" Height="35" 
                    Margin="5" Click="BtnFit_Click"/>

            <TextBlock x:Name="lblZoom" Text="Масштаб: 100%" 
                       VerticalAlignment="Center" Margin="20,0,0,0" 
                       FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="lblFile" Text="Файл не выбран"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="lblSize" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <!-- Область просмотра с прокруткой -->
        <ScrollViewer x:Name="scrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="DarkGray">
            <Image x:Name="image" Stretch="None"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </ScrollViewer>
    </DockPanel>
</Window>