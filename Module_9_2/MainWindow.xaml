<Window x:Class="Module_9_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление проектами и задачами" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <TabControl Margin="10">

        <!-- ВКЛАДКА 1: СОТРУДНИКИ -->
        <TabItem Header="Сотрудники">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtEmpName" Width="150" Height="25" Margin="0,0,10,0"/>
                    <TextBlock Text="Роль:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtEmpRole" Width="150" Height="25" Margin="0,0,10,0"/>
                    <Button Content="Добавить" Width="100" Height="25" Margin="0,0,5,0" Click="BtnAddEmp_Click"/>
                    <Button Content="Удалить" Width="100" Height="25" Click="BtnDelEmp_Click"/>
                </StackPanel>

                <DataGrid x:Name="gridEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- ВКЛАДКА 2: ПРОЕКТЫ -->
        <TabItem Header="Проекты">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtProjName" Width="200" Height="25" Margin="0,0,10,0"/>
                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cmbProjStatus" Width="150" Height="25" Margin="0,0,10,0">
                        <ComboBoxItem Content="Активен" IsSelected="True"/>
                        <ComboBoxItem Content="Завершен"/>
                    </ComboBox>
                    <Button Content="Добавить" Width="100" Height="25" Margin="0,0,5,0" Click="BtnAddProj_Click"/>
                    <Button Content="Обновить" Width="100" Height="25" Margin="0,0,5,0" Click="BtnUpdateProj_Click"/>
                    <Button Content="Удалить" Width="100" Height="25" Click="BtnDelProj_Click"/>
                </StackPanel>

                <DataGrid x:Name="gridProjects" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionChanged="GridProjects_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- ВКЛАДКА 3: ЗАДАЧИ -->
        <TabItem Header="Задачи">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Новая задача или редактирование" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <StackPanel Margin="5">
                            <TextBlock Text="Название задачи"/>
                            <TextBox x:Name="txtTaskTitle" Width="200" Height="25"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Проект"/>
                            <ComboBox x:Name="cmbTaskProject" Width="150" Height="25" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Исполнитель"/>
                            <ComboBox x:Name="cmbTaskEmployee" Width="150" Height="25" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Прогресс (0-100)"/>
                            <TextBox x:Name="txtTaskProgress" Width="100" Height="25" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                            <Button Content="Создать" Width="100" Height="25" Margin="0,0,5,0" Click="BtnAddTask_Click"/>
                            <Button Content="Обновить" Width="100" Height="25" Margin="0,0,5,0" Click="BtnUpdateTask_Click"/>
                            <Button Content="Удалить" Width="100" Height="25" Click="BtnDelTask_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <DataGrid x:Name="gridTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridTasks_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="150"/>
                        <DataGridTextColumn Header="Исполнитель" Binding="{Binding EmployeeName}" Width="150"/>
                        <DataGridTextColumn Header="Прогресс" Binding="{Binding Progress}" Width="80"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- ВКЛАДКА 4: ОТЧЕТЫ -->
        <TabItem Header="Отчеты">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24*"/>
                    <ColumnDefinition Width="21*"/>
                    <ColumnDefinition Width="1009*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="Сгенерировать отчет" Width="200" Height="30" HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnGenerateReport_Click" Grid.ColumnSpan="3"/>
                <TextBox x:Name="txtReport" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" Grid.ColumnSpan="3"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>