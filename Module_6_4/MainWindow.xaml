<Window x:Class="Module_6_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт финансов" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <DockPanel Margin="10">

        <!-- Панель ввода -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="Дата"/>
                <DatePicker x:Name="dpDate" Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Описание"/>
                <TextBox x:Name="txtDesc" Height="28" FontSize="14"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5">
                <TextBlock Text="Сумма"/>
                <TextBox x:Name="txtAmount" Height="28" FontSize="14"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" 
                        VerticalAlignment="Bottom" Margin="5">
                <Button Content="+ Доход" Width="110" Height="30"
                        FontSize="14" Margin="0,0,5,0"
                        Click="BtnIncome_Click" Background="#C8E6C9"/>
                <Button Content="− Расход" Width="110" Height="30"
                        FontSize="14" Margin="0,0,5,0"
                        Click="BtnExpense_Click" Background="#FFCDD2"/>
                <Button Content="Удалить" Width="100" Height="30"
                        FontSize="14" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>

        <!-- Итоговая панель -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" 
                Padding="15" Margin="0,10,0,0" BorderBrush="Gray" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Доходы" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="lblIncome" Text="0.00" 
                               FontSize="18" FontWeight="Bold" Foreground="Green"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Расходы" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="lblExpense" Text="0.00" 
                               FontSize="18" FontWeight="Bold" Foreground="Red"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Баланс" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="lblBalance" Text="0.00" 
                               FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица операций -->
        <DataGrid x:Name="grid" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  FontSize="14"
                  RowHeight="28">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" 
                                    Binding="{Binding Id}" 
                                    Width="50"/>

                <DataGridTextColumn Header="Дата" 
                                    Binding="{Binding Date}" 
                                    Width="110"/>

                <DataGridTextColumn Header="Описание" 
                                    Binding="{Binding Description}" 
                                    Width="*"/>

                <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding TypeDisplay}" 
                                    Width="100"/>

                <DataGridTextColumn Header="Сумма" 
                                    Binding="{Binding AmountDisplay}" 
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>